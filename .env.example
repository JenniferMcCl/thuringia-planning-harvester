# Default: offline fixtures. false selects the unverified live acquisition interface.
FIXTURE_MODE=true
FIXTURE_PATHS=["tests/fixtures/planning_basic.html"]
FIXTURE_BASE_URL=https://example.invalid/thueringen/bauleitplanung?page=1

# Fixture writes use only TEST_DATABASE_URL; this database is created if missing.
# Use a distinct name ending in _test or _fixture. The role needs CREATEDB initially.
TEST_DATABASE_URL=postgresql+psycopg://YOUR_ROLE@localhost:5432/thuringia_harvester_test

# Live writes use only DATABASE_URL. No fallback between database destinations.
DATABASE_URL=postgresql+psycopg://YOUR_ROLE@localhost:5432/thuringia_harvester
SOURCE_URL=https://thueringen.de/bauleitplanung
A4_GEOJSON_PATH=data/reference/a4_thueringen.geojson
STATE_GEOJSON_PATH=data/reference/thueringen_boundary.geojson
A4_BUFFER_METERS=10000
REQUEST_TIMEOUT=20
REQUEST_RETRIES=2
MAX_PAGES=20
